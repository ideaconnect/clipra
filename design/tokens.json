  "font": {
    "display": { "family": "Bricolage Grotesque", "weights": [700, 800], "use": "Screen titles, brand, big numbers (percent, length, price)" },
    "ui": { "family": "Geist", "weights": [400, 500, 600, 700], "use": "All UI text" },
    "mono": { "family": "Geist Mono", "weights": [400, 500, 600], "use": "Timecodes, sizes, resolutions, LUFS, file names on clips" }
  },
  "type": {
    "screenTitle": { "font": "display", "size": 22, "weight": 700 },
    "heroTitle": { "font": "display", "size": 34, "weight": 800 },
    "brand": { "font": "display", "size": 26, "weight": 800 },
    "headerTitle": { "font": "ui", "size": 15, "weight": 600 },
    "sectionLabel": { "font": "ui", "size": 13, "weight": 600, "color": "textSecondary" },
    "body": { "font": "ui", "size": 14, "weight": 500 },
    "caption": { "font": "ui", "size": 12, "weight": 400, "color": "textSecondary" },
    "button": { "font": "ui", "size": 15, "weight": 700 },
    "chip": { "font": "ui", "size": 13, "weight": 600 },
    "meta": { "font": "mono", "size": 11, "weight": 400, "color": "textSecondary" },
    "clipLabel": { "font": "mono", "size": 10, "weight": 600 },
    "clipTitle": { "font": "ui", "size": 10, "weight": 600 }
  },
  "radius": { "chip": 999, "card": 16, "cardLarge": 20, "button": 14, "buttonLarge": 16, "segmentContainer": 14, "segment": 10, "clip": 7, "thumb": 6 },
  "space": [2, 4, 6, 8, 10, 12, 14, 16, 20, 24, 32],
  "size": {
    "touchTarget": 48,
    "primaryButtonHeight": 56,
    "secondaryButtonHeight": 48,
    "segmentHeight": 44,
    "chipHeight": 36,
    "switchTrack": [48, 28],
    "switchKnob": 22,
    "phoneFrame": [390, 844],
    "tabletFrame": [1280, 800]
  },
  "timeline": {
    "phonePixelsPerSecond": 32,
    "tabletPixelsPerSecond": 48,
    "tabletLayerHeaderWidth": 120,
    "tabletLaneTopAndHeight": { "L6": [26, 24], "L5": [56, 28], "L4": [90, 34], "L3": [130, 56], "L2": [192, 32], "L1": [230, 32] },
    "beatMarkerSpacingPxAt48pps": 30
  },
  "icon": { "style": "Inline stroke icons, 1.8 to 2.2 stroke, round caps and joins, 24 grid. No emoji.", "crown": "Filled crown, used only for Clipra Pro" }
}
