<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
        The AdMob app id. UMP looks for it here even though Clipra also passes it in code, and the
        ads SDK reads it from code. The build fills it in (monetization/build.gradle.kts).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${adMobAppId}" />
    </application>
</manifest>
